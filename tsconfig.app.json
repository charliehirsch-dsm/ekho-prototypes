{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@rev-source/*": ["../../Repos/ekho/packages/ekho-common/src/rev/*"],
      "@config/*": ["../../Repos/ekho/apps/admin-portal/src/config/*"],
      "@features/*": ["../../Repos/ekho/apps/admin-portal/src/features/*"],
      "@pages/*": ["../../Repos/ekho/apps/admin-portal/src/pages/*"],
      "@app/*": ["../../Repos/ekho/apps/admin-portal/src/app/*"],
      "@assets/*": ["../../Repos/ekho/apps/admin-portal/src/assets/*"],
      "@common/*": ["../../Repos/ekho/apps/admin-portal/src/common/*"],
      "@admin/*": ["../../Repos/ekho/apps/admin-portal/src/*"],
      "@carthage/*": ["../../Repos/ekho/apps/carthage/src/*"],
      "@grader/*": ["../../Repos/ekho/apps/grader/src/*"],
      "@ops/*": ["../../Repos/ekho/apps/ops-portal/src/*"],
      "@ekhodealer/ekho-common/rev": ["../../Repos/ekho/packages/ekho-common/src/rev"],
      "@ekhodealer/ekho-common/rev/*": ["../../Repos/ekho/packages/ekho-common/src/rev/*"],
      "@ekhodealer/ekho-common/utils": ["../../Repos/ekho/packages/ekho-common/src/utils"],
      "@ekhodealer/ekho-common/utils/*": ["../../Repos/ekho/packages/ekho-common/src/utils/*"],
      "@ekhodealer/ekho-common/auth-client": ["../../Repos/ekho/packages/ekho-common/src/auth-client"],
      "@ekhodealer/ekho-common/auth-client/*": ["../../Repos/ekho/packages/ekho-common/src/auth-client/*"],
      "@ekhodealer/ekho-common/server": ["../../Repos/ekho/packages/ekho-common/src/server"],
      "@ekhodealer/ekho-common/server/*": ["../../Repos/ekho/packages/ekho-common/src/server/*"],
      "@ekhodealer/ekho-common/components": ["../../Repos/ekho/packages/ekho-common/src/components"],
      "@ekhodealer/ekho-common/components/*": ["../../Repos/ekho/packages/ekho-common/src/components/*"],
      "@ekhodealer/ekho-common": ["../../Repos/ekho/packages/ekho-common/src"]
    },

    /* Relaxed for prototype use - importing raw Rev source with different TS settings */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
